BOLD="\[\e[1m\]"
RESET_COLORS="\[\e[0m\]"

# get current branch in git repo
function parse_git_branch() {
	local line status_output branch bits=""

	status_output=$(git status --porcelain=v1 -b 2>/dev/null) || return

	while IFS= read -r line; do
		if [[ $line == "## "* ]]; then
			branch="${line#\#\# }"
			# Handle "No commits yet on <branch>" or "Initial commit on <branch>"
			if [[ $branch == "No commits yet on "* ]]; then
				branch="${branch#No commits yet on }"
			elif [[ $branch == "Initial commit on "* ]]; then
				branch="${branch#Initial commit on }"
			else
				branch="${branch%%...*}"
				branch="${branch%% \[*}"
			fi
			[[ $line == *"[ahead"* ]] && bits="*"
		else
			case "${line:0:2}" in
				"R "*)
					[[ $bits != *">"* ]] && bits=">${bits}"
					;;
				"A "*)
					[[ $bits != *"+"* ]] && bits="+${bits}"
					;;
				"??")
					[[ $bits != *"?"* ]] && bits="?${bits}"
					;;
				"D "|" D")
					[[ $bits != *"x"* ]] && bits="x${bits}"
					;;
				" M"|"M "|"MM")
					[[ $bits != *"!"* ]] && bits="!${bits}"
					;;
			esac
		fi
	done <<< "$status_output"

	[[ -n $branch ]] && echo "${branch}${bits}"
}

function printPrompt() {
	SEPARATOR="∵"
	PREVIOUS_EXIT_CODE=$1

	GIT=$(parse_git_branch)
	HOST=$_CACHED_HOSTNAME

	TEXT_COLOR_HOST=82
	TEXT_COLOR_DIRECTORY=81
	TEXT_COLOR_GIT=171
	TEXT_COLOR_CHEZMOI=220
	TEXT_COLOR_GOOD=255
	TEXT_COLOR_SEPARATOR=245

	PROMPT=""

	if [[ -n "$SSH_CLIENT" ]]; then
		PROMPT+="$(terminalColor $TEXT_COLOR_HOST)$BOLD$HOST"
		PROMPT+="$(terminalColor $TEXT_COLOR_SEPARATOR) $SEPARATOR "
	fi

	if [[ -n "$CHEZMOI" ]]; then
		PROMPT+="$(terminalColor $TEXT_COLOR_CHEZMOI)${BOLD}chezmoi"
	else
		PROMPT+="$(terminalColor $TEXT_COLOR_DIRECTORY)$BOLD$(workingDirectory)"
	fi

	if [[ -n "$GIT" ]]; then
		PROMPT+="$(terminalColor $TEXT_COLOR_SEPARATOR) $SEPARATOR "
		PROMPT+="$(terminalColor $TEXT_COLOR_GIT)$BOLD$GIT"
	fi

	PROMPT+="${RESET_COLORS}"
	PROMPT+="$(terminalColor $TEXT_COLOR_GOOD)"
	PROMPT+=" \\$"

	echo -e "$PROMPT"
}

function terminalColor() {
	FOREGROUND="\[\e[38;5;${1}m\]"
	BACKGROUND="\[\e[48;5;${2}m\]"

	if [[ -z "${1}" ]]; then
		FOREGROUND="\[\e[38;5;15m\]"
	fi

	if [[ -z "${2}" || "${2}" -eq "-1" ]]; then
		BACKGROUND=""
	fi

	echo ${RESET_COLORS}${FOREGROUND}${BACKGROUND}
}

function workingDirectory() {
	local path="${PWD/#$HOME/\~}"
	local IFS='/'
	local parts=($path)
	local output="" i last=$((${#parts[@]} - 1))

	for i in "${!parts[@]}"; do
		local part="${parts[$i]}"
		[[ -z $part ]] && continue

		if (( i < last )); then
			if [[ ${part:0:1} =~ [^A-Za-z0-9] ]]; then
				output+="/${part:0:2}"
			else
				output+="/${part:0:1}"
			fi
		else
			output+="/${part}"
		fi
	done

	[[ $path == /* ]] || output="${output:1}"  # strip leading / for relative paths
	echo "${output:-/}"
}

function set_bash_prompt() {
	PS1="$(printPrompt $?)$RESET_COLORS "
}

function um() {
	cat ~/um/*$1*
}

{{- if has "chesscom" .tags }}
function trans() {
	grep "$*" ~/Workspace/chess/app/Resources/assets/js/translations/messages.en_US.json
}

function route() {
	grep -Rn $* ~/Workspace/chess/src/Chess/WebBundle/Resources/config/routing/*
}

function branch() {
	if [[ $# -eq 0 ]]; then
		selected_branch=$(
			COLUMNS=1
			PS3="branch> "

			select branch in $(git branch | sed -e 's/[* ]//g'); do
				echo "${branch}"
				break
			done
		)

		if [[ -n "${selected_branch}" ]]; then
			git checkout "${selected_branch}"
		fi
	else
		local new_branch_name=$(echo $* | sed -e "s/ /-/g")

		if [[ ! "${new_branch_name}" =~ CV-[0-9]{6} ]]; then
			read -p "No ticket in branch name. Create anyway? [y/N]" -n 1 -r -s CHOICE
			echo
			echo

			case "${CHOICE}" in
				y|Y)
					;;

				n|N|*)
					return
					;;
			esac
		fi

		git checkout -b PN/${new_branch_name}
	fi
}

function commit() {
	local branch=$(git branch 2> /dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/\1/')
	local formatted_ticket=""

	if [[ "${branch}" =~ (CV-[0-9]{6}) ]]; then
		formatted_ticket="${BASH_REMATCH[1]} - "
	else
		read -p "No ticket found in branch name. Commit anyway? [y/N]" -n 1 -r -s CHOICE
		echo
		echo

		case "${CHOICE}" in
			y|Y)
				;;

			n|N|*)
				return
				;;
		esac
	fi

	git commit -m "${formatted_ticket}$*"
}

function chess() {
