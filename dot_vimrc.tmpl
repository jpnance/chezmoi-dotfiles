" ============================================================
" TAB COMPLETION
" ============================================================

function! InsertTabWrapper()
	let col = col('.') - 1
	if !col
		return "\<tab>"
	endif

	let char = getline('.')[col - 1]
	if char =~ '\k'
		" There's an identifier before the cursor, so complete the identifier.
		return "\<c-p>"
	else
		return "\<tab>"
	endif
endfunction

inoremap <expr> <tab> InsertTabWrapper()
inoremap <s-tab> <c-n>

