function! YankGitHubLink()
	let l:remote = trim(system('git remote get-url origin 2>/dev/null'))

	if v:shell_error
		echo 'Not in a git repository'
		return
	endif

	let l:repo = substitute(l:remote, '.*github\.com[:/]\(.\{-}\)\(\.git\)\?$', '\1', '')

	let l:head_ref = trim(system('git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null'))
	let l:branch = substitute(l:head_ref, 'refs/remotes/origin/', '', '')

	let @+ = 'https://github.com/' . l:repo . '/tree/' . l:branch . '/' . expand('%') . '#L' . line('.')
endfunction

nnoremap <silent> <Leader>yg :call YankGitHubLink()<CR>

