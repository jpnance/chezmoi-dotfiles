" ============================================================
" INDENTATION
" ============================================================

function! ApplyIndentationToBuffer(state)
	if a:state == 'spaces-2'
		setlocal expandtab tabstop=2
	elseif a:state == 'spaces-4'
		setlocal expandtab tabstop=4
	elseif a:state == 'tabs-4'
		setlocal noexpandtab tabstop=4
	endif
endfunction

function! ApplyIndentationAuto()
	let l:detected = DetectIndentation()
	call ApplyIndentationToBuffer(l:detected != '' ? l:detected : g:my.default_indentation)
endfunction

function! CycleIndentation()
	let l:states = ['spaces-2', 'spaces-4', 'tabs-4']
	let l:next_index = (index(l:states, g:my.default_indentation) + 1) % len(l:states)
	let g:my.default_indentation = l:states[l:next_index]
	call ApplyIndentationToBuffer(g:my.default_indentation)
	echo 'Tab style: ' . g:my.default_indentation
endfunction

function! DetectIndentation()
	if search('^\t', 'nw')
		return 'tabs-4'
	elseif search('^  \S', 'nw')
		return 'spaces-2'
	elseif search('^    \S', 'nw')
		return 'spaces-4'
	else
		return ''
	endif
endfunction

augroup indentation
	autocmd!
	autocmd FileType * call ApplyIndentationAuto()
augroup END

filetype plugin on

