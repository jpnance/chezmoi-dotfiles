" ============================================================
" CHESS PROJECT
" ============================================================

function! GoToFile(cmd)
	let l:fname = expand('<cfile>')
	let l:resolved = ResolveImport(l:fname)
	execute a:cmd . ' ' . fnamemodify(l:resolved, ':.')
endfunction

function! ResolveImport(fname)
	let l:prefixes = ['shared/', 'web/core/', '']
	let l:suffixes = ['', '.ts', '.d.ts', '.js', '.vue', '/index.ts', '/index.vue']

	if a:fname =~ '^\.\.\?/'
		let l:dir = expand('%:p:h')
		let l:base = simplify(l:dir . '/' . a:fname)

		for l:suffix in l:suffixes
			if filereadable(l:base . l:suffix)
				return l:base . l:suffix
			endif
		endfor

		return l:base
	endif

	let l:root = getcwd() . '/client'
	let l:parts = split(a:fname, '/')

	if l:parts[0] == 'chesscom' || l:parts[0] == '@chesscom'
		call remove(l:parts, 0)
		call insert(l:parts, 'dist', 1)
		return l:root . '/node_modules/@chesscom/' . join(l:parts, '/')
	endif

	for l:prefix in l:prefixes
		for l:suffix in l:suffixes
			let l:candidate = l:root . '/' . l:prefix . a:fname . l:suffix
			if filereadable(l:candidate)
				return l:candidate
			endif
		endfor
	endfor

	return a:fname
endfunction

function! SearchForImports()
	let l:filename = fnamemodify(expand('%'), ':t:r')

	execute 'silent! grep! import.*' . l:filename
	redraw!

	if len(getqflist()) > 0
		copen
	else
		echo "No results found."
	endif
endfunction

function! GoToDefinition(cmd)
	let l:symbol = expand('<cword>')

	if l:symbol =~ '-'
		let l:symbol = KebabToPascal(l:symbol)
	endif

	let l:content = join(getline(1, '$'), ' ')
	
	let l:pattern = "import\\s*\\(type\\s*\\)\\?[^;]*\\<" . l:symbol . "\\>[^;]*from\\s*['\"]\\zs[^'\"]*\\ze"
	let l:path = matchstr(l:content, l:pattern)
	
	if empty(l:path)
		echo "Could not find import for " . l:symbol
		return
	endif
	
	let l:resolved = ResolveImport(l:path)
	
	if isdirectory(l:resolved)
		let l:matches = systemlist('grep -l "\b' . l:symbol . '\b" ' . shellescape(l:resolved) . '/* 2>/dev/null')
		if len(l:matches) > 0
			execute a:cmd . ' ' . fnamemodify(l:matches[0], ':.')
			call search('\<' . l:symbol . '\>')
			return
		endif
		execute 'Explore ' . l:resolved
	else
		execute a:cmd . ' ' . fnamemodify(l:resolved, ':.')
		call search('\<' . l:symbol . '\>')
	endif
endfunction

function! KebabToPascal(str)
	return substitute(a:str, '\(-\|^\)\([a-z]\)', '\u\2', 'g')
endfunction

let s:pwd = getcwd()

if s:pwd =~ "Workspace/chess"
	let pathsWeCareAbout = ["/client/web/**", "/client/shared/**", "/client/tests/**", "/client/types/**", "/src/Chess/WebBundle/**", "/src/Chess/CoreBundle/**"]
	let &path = join(map(pathsWeCareAbout, { i, path -> s:pwd .. path}), ',')

	set includeexpr=ResolveImport(v:fname)
	set grepprg=git\ grep\ -n\ $*\ --\ ':!*translations*'\ ':!*js_routes*'\ ':!*release-history.md*'
endif

