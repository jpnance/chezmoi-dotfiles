#
# ~/.bash_profile
#

if [[ ":$PATH:" != *":$HOME/bin:"* ]]; then
	export PATH=$HOME/bin:$PATH
fi

{{- if has "chesscom" .tags }}
if [[ ":$PATH:" != *":/opt/homebrew/bin:"* ]]; then
	export PATH=/opt/homebrew/bin:$PATH
fi

if [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
	export PATH=$HOME/.local/bin:$PATH
fi
{{- end }}

[[ -f ~/.bashrc ]] && . ~/.bashrc
