#!/bin/bash
# mrpretty - Mr. Pretty formats mongorestore output

if [ -t 0 ]; then
	echo "Usage: mongorestore ... 2>&1 | mrpretty"
	echo ""
	echo "Formats mongorestore output into a readable summary."
	exit 1
fi

logfile="/tmp/mongorestore.$(date +%Y-%m-%d_%H-%M-%S).log"
cat > "$logfile"
output=$(cat "$logfile")

# Parse "finished restoring db.collection (N documents, M failures)" lines
data=$(echo "$output" | grep "finished restoring" | \
	sed 's/.*finished restoring [^.]*\.\([^ ]*\) (\([0-9]*\) document.*, \([0-9]*\) failure.*/\1 \2 \3/')

col_count=$(echo "$data" | wc -l | tr -d ' ')
total_failures=$(echo "$data" | awk '{s+=$3} END {print s+0}')
total_docs=$(echo "$output" | grep -E "document\(s\) restored successfully" | \
	sed 's/.*\t\([0-9]*\) document.*/\1/')

# Header
echo "✓ $col_count collections restored"
[ "$total_failures" -eq 0 ] && echo "✓ 0 failures" || echo "✗ $total_failures failures"

# Flag empties
empty=$(echo "$data" | awk '$2 == 0 {print $1}' | paste -sd, -)
[ -n "$empty" ] && echo "⚠ empty: $empty"

echo ""

# Sorted list with dot leaders
echo "$data" | sort -t' ' -k2 -rn | awk '{
	name = $1
	docs = $2
	dots = ""
	pad = 24 - length(name)
	for (i = 0; i < pad; i++) dots = dots "."
	printf "  %s %s %\047d\n", name, dots, docs
}'

echo ""
echo "Total: $total_docs documents"
echo ""
echo "Full log: $logfile"
