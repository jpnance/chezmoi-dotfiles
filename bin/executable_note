#!/bin/bash
set -euo pipefail

initial_pwd=${PWD}

if [[ $# -eq 0 ]]; then
	cd ${HOME}/notes

	vim .
else
	filename="$1"

	yearstamp=$(date +%Y)
	daystamp=$(date +%m%d)
	directory=${HOME}/notes/${yearstamp}/${daystamp}

	mkdir -p ${directory}

	cd ${directory}

	vim -c "e ${directory}/${filename}" -c "cd ../.."

	cd ${HOME}/notes
fi

find . -type d -empty -delete

if [[ -n "$(git status --porcelain)" ]]; then
	git add .
	git commit -m "$(git status -s)"
	git push
else
	echo "No changes to commit."
fi

cd ${initial_pwd}
